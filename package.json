{
  "name": "puki-music-windows",
  "version": "1.0.6",
  "description": "Native Windows Client for Puki Music with Two-Tier Discography Engine & E2EE Sync",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "bundle": "tsc && vite build",
    "build": "tsc && vite build && electron-builder --publish never",
    "build:electron": "electron-builder --win nsis",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "puki-music",
    "windows",
    "desktop-player",
    "innertube"
  ],
  "author": "Nands (Queryzy)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-electron": "^0.28.1",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.330.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1"
  },
  "build": {
    "appId": "com.puki.music.windows",
    "productName": "Puki Music",
    "publish": [
      {
        "provider": "github",
        "owner": "Queryzy",
        "repo": "Puki-Music-Windows"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Puki Music"
    }
  }
}
